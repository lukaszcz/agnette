# Agent-enhanced git operations

import std/config
import std/git
import devel/utils

@doc("""
  Merge `ref` into the current branch, asking the agent to resolve conflicts.

  Merge configuration such as `merge.ff`, `merge.autoStash` and `merge.log` does not apply; see
  `std/git::merge`.

  Raises `GitError` when git cannot merge `ref`.
""")
def Agent::merge(self, ref: git::ref, interactive: bool = false) -> unit =
  case git::merge(ref) of
    | git::Conflicted(_) =>
      let prompt = """
        Fix all conflicts and finish the merge.
        Make sure to preserve functionality from both branches.
      """
      self.ask-or-chat(prompt, interactive)
    | _ => ()

def Agent::commit(self) -> unit =
  self.ask("Commit changes on the current branch.")

@command("devel merge")
@doc("Merge given ref and fix all conflicts.")
program def merge-main(
  ref: text,
  agent: Agent = config::default-agent,
  @opt-short("i")
  interactive: bool = false
) -> unit =
  agent.merge(ref, interactive)

@command("devel commit")
@doc("Commit changes on the current branch.")
program def commit-main(
  agent: Agent = config::default-agent
) -> unit =
  agent.commit()
