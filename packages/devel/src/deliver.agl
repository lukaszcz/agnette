@!doc("Plan delivery workflows.")

import std/config
import std/session::Session
import std/fs
import std/git
import std/log
import std/os
import std/path
import std/ps
import std/text::join
import std/time
import devel/git as agent-git
import devel/utils
import devel/review

enum VerifyResult
  | Complete
      @doc("file path of next unblocked task, or None if all tasks finished")
      next-task-file: Option[path]
  | Incomplete
      reason: text

record TaskRun
  task-file: path
  branch: text
  worktree: path
  process: ps::Process[unit]

def make-tasks-prompt(plan-file: path, tasks-dir: path, instructions: text = "") -> text =
  let instructions' =
    if text::is-empty(instructions) => ""
    else => "## Instructions\n\n%{instructions}"
  """
  Read %{plan-file} and create implementation tasks for this plan. Make sure that each task can be implemented by an agent in 200k context widow. If the steps described in the plan are too big, split them into multiple tasks.

  In each task, add a brief "Context" section summarizing what the ultimate goals of the whole plan are. Make it clear that any work done must be a step toward these goals, but the ultimate plan goals are not acceptance criteria for the task.

  Save the task files to %{tasks-dir}/TASK_*.md. Create a task index in %{tasks-dir}/TASK_INDEX.md. Create %{tasks-dir}/PROGRESS.md to track task progress - list of completed and remaining tasks, next unblocked task.

  ## Format of PROGRESS.md

  Only three sections:
  1. Task status for each task (a list)
      - done / blocked / unblocked (not started / in progress)
  2. Next unblocked task
  3. Completion log
      - ONE line per task as each task lands (explicitly state this requirement)

  Keep PROGRESS.md concise.

  %{instructions'}
  """

def Agent::make-tasks(self, plan-file: path, tasks-dir: path, instructions: text = "") -> unit =
  self.ask <| make-tasks-prompt(plan-file, tasks-dir, instructions)

def implement-task-prompt(task-file: path, incomplete-reason: Option[text]) -> text =
  let reason =
    case incomplete-reason of
      | Some(value) =>
        """

        ## Reason task is not done

        %{value}
        """
      | None =>
        ""
  """
  Implement the task described in @%{task-file}. Commit when done.

  A task is not done until all its acceptance criteria are satisfied. Do not mark partially done tasks as complete. Never defer any work.
  """ ++ reason

def Agent::implement-task(self, task-file: path, incomplete-reason: Option[text]) -> unit =
  self.ask <| implement-task-prompt(task-file, incomplete-reason)

def update-task-progress-prompt(tasks-dir: path) -> text =
  """
  Update %{tasks-dir}/PROGRESS.md to track current task progress - completed and remaining tasks, next unblocked task (not yet completed and not blocked by other tasks).

  ## Format of PROGRESS.md

  Only three sections:
  1. Task status for each task (list)
      - done / blocked / unblocked (not started / in progress)
  2. Next unblocked task
  3. Completion log
      - ONE line per task as each task lands (explicitly state this requirement)

  Keep PROGRESS.md concise.
  """

def check-task-prompt(task-file: path) -> text =
  """
  Verify if %{task-file} is completed. Check the implementation against the corresponding task file.

  IMPORTANT: A task is not done until all its acceptance criteria are satisfied. Do not mark partially done tasks as complete. Do not consider deferrals as signs of completion.
  """

def verify-task-prompt(task-file: path, tasks-dir: path) -> text =
  """
  %{check-task-prompt(task-file)}

  %{update-task-progress-prompt(tasks-dir)}

  ## Response

  - If %{task-file} is complete, return `Complete` with the path to the next unblocked task or `None` if all tasks are complete.
  - If %{task-file} is not complete, return `Incomplete` with a reason for why the task is not complete.
  """

def Session::verify-task(self, task-file: path, tasks-dir: path) -> VerifyResult =
  self.ask <| verify-task-prompt(task-file, tasks-dir)

def verify-worktree-task-prompt(task-file: path) -> text =
  """
  %{check-task-prompt(task-file)}

  The implementation is on the current branch in the current directory. Do not modify any files.

  ## Response

  - If %{task-file} is complete, return `Complete` with `None`.
  - If %{task-file} is not complete, return `Incomplete` with a reason for why the task is not complete.
  """

def Session::verify-worktree-task(self, task-file: path) -> VerifyResult =
  self.ask <| verify-worktree-task-prompt(task-file)

def mark-done-prompt(task-file: Option[path]) -> text =
  case task-file of
    | Some(value) => "Mark %{value} as done. "
    | None => ""

def select-next-task-prompt(task-file: Option[path], tasks-dir: path) -> text =
  mark-done-prompt(task-file) ++
  update-task-progress-prompt(tasks-dir) ++
  """

  ## Response

  Return the next unblocked task file path, or None if all tasks are complete.
  """

def Session::select-next-task(self, task-file: Option[path], tasks-dir: path) -> Option[path] =
  self.ask <| select-next-task-prompt(task-file, tasks-dir)

# Returns the next task reported by the verification that completed `task-file`.
def revise-until-complete(task-file: path, exec-agent: Agent, verify: () -> VerifyResult) -> Option[path] =
  var next-task: Option[path] = None
  do
    log::info("Verifying task %{task-file}")
    let r = verify()
    case r of
      | Complete(next-task-file) =>
        log::info("Task complete")
        next-task := next-task-file
      | Incomplete(reason) =>
        log::info("Task incomplete: %{reason}")
        log::info("\nRevising implementation of %{task-file}")
        exec-agent.implement-task(task-file, Some(reason))
  until r is Complete
  next-task

def refine-task(task-file: path, review-agent: Agent, revise-agent: Agent, max-refine-steps: int, save-reviews: bool) -> unit =
  if max-refine-steps > 0 =>
    review::refine("the implementation of %{task-file}", review::default-aspects ++ ", adherence to %{task-file}", review-agent, revise-agent, max-refine-steps, save-reviews)

def Session::deliver-plan(self, plan-file: path, tasks-dir: path, exec-agent: Agent, review-agent: Agent, revise-agent: Agent, verify: bool, max-refine-steps: int, save-reviews: bool) -> unit =
  var next-task: Option[path] = self.select-next-task(None, tasks-dir)
  while next-task is Some do
    let task-file = next-task.unwrap()
    log::info-heading("Implementing task %{task-file}")
    exec-agent.implement-task(task-file, None)
    if verify =>
      next-task := revise-until-complete(task-file, exec-agent, fn() => self.verify-task(task-file, tasks-dir))
    else =>
      next-task := self.select-next-task(Some(task-file), tasks-dir)
    refine-task(task-file, review-agent, revise-agent, max-refine-steps, save-reviews)
  done

def select-ready-tasks-prompt(task-file: Option[path], in-progress: array[path], tasks-dir: path) -> text =
  let in-progress-list = join(in-progress.map(fn(file: path) => "- %{file}"), "\n")
  mark-done-prompt(task-file) ++
  update-task-progress-prompt(tasks-dir) ++
  """

  ## Tasks in progress

  Only the following tasks are in progress now, whatever PROGRESS.md says:

  %{in-progress-list}

  ## Response

  Return the absolute paths of all task files that are not yet completed, not in progress, and not blocked by uncompleted tasks. A task that depends on a task in progress is blocked. Return an empty array if there are no such tasks.
  """

def Session::select-ready-tasks(self, task-file: Option[path], in-progress: array[path], tasks-dir: path) -> array[path] =
  let ready: array[path] = self.ask <| select-ready-tasks-prompt(task-file, in-progress, tasks-dir)
  ready.map(path::absolute)

# Runs in a forked child, which owns its working directory: agent calls and git act on `worktree`.
def deliver-task(task-file: path, worktree: path, main-dir: path, verify-agent: Agent, exec-agent: Agent, review-agent: Agent, revise-agent: Agent, verify: bool, max-refine-steps: int, save-reviews: bool) -> unit =
  os::chdir(worktree)
  log::info-heading("Implementing task %{task-file}")
  exec-agent.implement-task(task-file, None)
  if verify =>
    let session = session::Session::open(verify-agent)
    let _ = revise-until-complete(task-file, exec-agent, fn() => session.verify-worktree-task(task-file))
    session.close()
  refine-task(task-file, review-agent, revise-agent, max-refine-steps, save-reviews)
  for review-file in fs::glob("reviews/*", ".agent-files") do
    fs::copy(".agent-files/%{review-file}", "%{main-dir}/.agent-files/%{review-file}")
  # Removing the worktree discards whatever is not committed.
  if not git::is-clean() =>
    exec-agent.commit()

# Keeps a branch with unmerged commits: it holds the only copy of that work.
def TaskRun::remove(self) -> unit =
  git::worktree::remove(self.worktree, true)
  if git::is-ancestor(self.branch, "HEAD") =>
    git::branch::delete(self.branch)
  else =>
    log::warn("Keeping unmerged branch %{self.branch} of %{self.task-file}")

@doc("""
  Deliver the tasks in `tasks-dir` like `deliver-plan`, running up to `jobs` tasks concurrently.

  Each task runs in a forked process, in a temporary worktree on a branch of its own, and starts
  once the tasks it depends on are merged. A finished task is merged into the current branch, with
  `exec-agent` resolving conflicts, and its worktree and branch are removed. The orchestrator
  session runs here, while a slot is free, and alone updates PROGRESS.md.

  The first failure terminates the running tasks and is raised again, after removing their worktrees.
  Branches with unmerged commits are kept. Raises `RangeError` if `jobs` is not positive.
""")
def Session::deliver-plan-parallel(self, plan-file: path, tasks-dir: path, exec-agent: Agent, review-agent: Agent, revise-agent: Agent, verify: bool, max-refine-steps: int, save-reviews: bool, jobs: int) -> unit =
  if jobs < 1 =>
    raise RangeError(message = "jobs must be positive, got %{jobs}")
  let main-dir = os::cwd()
  # Task files may be ignored by git, so workers read them from the main repository.
  let tasks-path = path::absolute(tasks-dir)
  let worktrees-dir = fs::temp-dir()
  let branch-prefix = "deliver-%{time::timestamp()}"
  var running: array[TaskRun] = []
  var started: array[path] = []
  var merged: Option[path] = None
  try
    while true do
      let in-progress = running.map(fn(run: TaskRun) => run.task-file)
      let ready = self.select-ready-tasks(merged, in-progress, tasks-path)
        .select(fn(task-file: path) => not started.contains(task-file))
      for task-file in ready.take(jobs - running.size()) do
        started.push(task-file)
        let worktree = "%{worktrees-dir}/task-%{started.size()}"
        let branch = "%{branch-prefix}/task-%{started.size()}"
        git::worktree::add(worktree, new-branch = Some(branch))
        let process = ps::fork(fn() =>
          deliver-task(task-file, worktree, main-dir, self.agent, exec-agent, review-agent, revise-agent, verify, max-refine-steps, save-reviews))
        running.push(TaskRun(task-file, branch, worktree, process))
      if running.is-empty() =>
        break
      let index = ps::settle-any(running.map(fn(run: TaskRun) => run.process))
      let run = running[index]
      ps::wait(run.process)
      log::info-heading("Merging task %{run.task-file}")
      exec-agent.merge(run.branch)
      if not git::is-ancestor(run.branch, "HEAD") =>
        raise Abort(message = "Merge of %{run.branch} did not finish")
      let _ = running.remove-at(index)
      run.remove()
      merged := Some(run.task-file)
  catch _ =>
    for run in running do
      ps::terminate(run.process)
      run.remove()
    raise

def implement-tasks-prompt(plan-file: path, tasks-dir: path, impl-model: text, review-model: text, jobs: int) -> text =
  let jobs-prompt =
    if jobs > 0 =>
      "Use at most %{jobs} parallel subagents in independent worktrees. Parallelize as much as possible. Remember to remove the worktrees and branches you created when merged and no longer needed."
    else =>
      "Launch subagents sequentially one at a time, not in parallel."
  """
  Implement the tasks from %{tasks-dir}/TASK_*.md, tracked in %{tasks-dir}/PROGRESS.md. The tasks describe implementation steps for the plan in %{plan-file}

  Use %{impl-model} subagents to implement the tasks. %{jobs-prompt} Choose the next task based on %{tasks-dir}/PROGRESS.md.

  A task is not done until all its acceptance criteria are satisfied. Do not mark partially done tasks as complete. Never defer any work.

  After each implementation agent finishes, use a %{review-model} subagent to review its work for correctness, completeness, maintainability, adherence to the task file and to relevant AGENTS.md files.

  For EVERY issue identified by the reviewer, check if the issue is valid and if so, dispatch a %{impl-model} subagent to fix it. If the review surfaces deeper architectural problems, resolve them yourself first by making reasonable design and architecture choices. All solutions must be principled, general, extensible and maintainable. EVERY issue identified by a reviewer MUST be addressed (fixed or ruled invalid).

  After completing each task:
  1. commit in the main repo,
  2. update %{tasks-dir}/PROGRESS.md and other relevant files in %{tasks-dir}

  ## Acceptance criteria

  The goal is not complete until all acceptance criteria of every task and of the plan are met.

  Do NOT expand scope beyond what is specified in the plan and the tasks.

  ## Format of PROGRESS.md

  Only three sections:
  1. Task status for each task
      - done / blocked / unblocked (not started / in progress)
  2. Next unblocked task
  3. Completion log
      - ONE line per task as each task lands (explicitly state this requirement)

  Keep PROGRESS.md concise.
  """

def Agent::implement-tasks(self, plan-file: path, tasks-dir: path, impl-model: text, review-model: text, jobs: int, interactive: bool) -> unit =
  self.ask-or-chat(implement-tasks-prompt(plan-file, tasks-dir, impl-model, review-model, jobs), interactive)

let default-tasks-dir = ".agent-files/tasks"

@command("devel make-tasks")
@doc("Create task files for a plan")
program def make-tasks-main(
  plan-file: path,
  @doc("Task directory. Default: %{default-tasks-dir}")
  tasks-dir: path = default-tasks-dir,
  agent: Agent = config::agent,
  instructions: text = ""
) -> unit =
  agent.make-tasks(plan-file, tasks-dir, instructions)

@command("devel deliver")
@doc("Deliver an implementation for a plan")
program def deliver-main(
  plan-file: path,
  @doc("Task directory. Default: %{default-tasks-dir}")
  tasks-dir: path = default-tasks-dir,
  @doc("Orchestrator agent - creates tasks from plan, selects next task, verifies task completion, updates progress tracker")
  agent: Agent = config::agent,
  @doc("Executor agent - implements the tasks")
  exec-agent: Agent = agent,
  @doc("Review agent for post-completion task refinement")
  review-agent: Agent = agent,
  @doc("Revise agent for post-completion task refinement")
  revise-agent: Agent = agent,
  @doc("Should the orchestrator verify task completion?")
  verify: bool = true,
  @doc("Max review-revise refinement loop steps. Default: 0")
  max-refine-steps: int = 0,
  @doc("Save reviews in the refinement loop?")
  save-reviews: bool = false
) -> unit =
  log::info-heading("Plan delivery")
  log::info("plan: %{plan-file}")
  log::info("tasks-dir: %{tasks-dir}")
  log::info("orchestrator: %{agent}")
  log::info("executor: %{exec-agent}")
  if not fs::is-file("%{tasks-dir}/PROGRESS.md") =>
    log::info-heading("Preparing task files")
    agent.make-tasks(plan-file, tasks-dir)
  let session = session::Session::open(agent)
  session.deliver-plan(plan-file, tasks-dir, exec-agent, review-agent, revise-agent, verify, max-refine-steps, save-reviews)
  session.close()

@command("devel implement-tasks")
@doc("Implement tasks in a single agent session")
program def implement-tasks-main(
  agent: Agent = config::agent,
  plan-file: path = ".agent-files/PLAN.md",
  tasks-dir: path = default-tasks-dir,
  @doc("Implementation model. Empty string means not specified.")
  impl-model: text = "",
  @doc("Review model. Empty string means not specified.")
  review-model: text = "",
  @opt-short("j")
  @doc("Number of parallel jobs.")
  jobs: int = 0,
  @opt-short("i")
  interactive: bool = false
) -> unit =
  agent.implement-tasks(plan-file, tasks-dir, impl-model, review-model, jobs, interactive)

@command("devel implement-plan")
@doc("Divide a plan into tasks and implement them in a single agent session")
program def implement-plan-main(
  agent: Agent = config::agent,
  plan-file: path = ".agent-files/PLAN.md",
  tasks-dir: path = default-tasks-dir,
  @doc("Implementation model. Empty string means not specified.")
  impl-model: text = "",
  @doc("Review model. Empty string means not specified.")
  review-model: text = "",
  @opt-short("j")
  @doc("Number of parallel jobs.")
  jobs: int = 0,
  @opt-short("i")
  interactive: bool = false,
  @doc("Extra instructions for task creation.")
  instructions: text = ""
) -> unit =
  agent.make-tasks(plan-file, tasks-dir, instructions)
  agent.implement-tasks(plan-file, tasks-dir, impl-model, review-model, jobs, interactive)
