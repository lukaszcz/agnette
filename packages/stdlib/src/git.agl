# Git repositories, driven by the `git` executable (minimum git 2.36).
#
# Paths: every repository-content path, argument or result, is relative to the work-tree root and
# matched literally (no globbing). `repo` names any directory inside the target work tree and, like
# every filesystem location, resolves relative to the process working directory; for `init` and
# `clone` it is the directory to create.
#
# Refs: a `ref` is any revision text git accepts. Functions that pass it to git do so in a form
# that cannot be read as an option.
#
# Errors: every failed git invocation raises `GitError`; failures are never classified by message
# text. An operation that can stop on conflicts returns an outcome with a `Conflicted` member and
# leaves the repository mid-operation. `exec` failures (timeout, undecodable output) propagate as
# `ExecError`.
#
# Git runs with the ambient `std/env::environ` and `std/config::timeout`, plus fixed
# non-interactive overrides: git's terminal prompts are off, while credential helpers and askpass
# programs of the environment still apply. ssh's own prompts (host key, passphrase on /dev/tty) are
# not covered by `GIT_TERMINAL_PROMPT`.
import std/array
import std/env
import std/errors::Exception
import std/fs::exists
import std/fs::read
import std/option::Option
import std/pair::Pair
import std/path
import std/path::path
import std/text::{++}
import std/text::join

@doc("Any revision: branch, tag, hash, `HEAD~2`, `stash@{0}`, `FETCH_HEAD`.")
type ref = text

@doc("""
  A failed git invocation.

  `args` is the full git argument vector, including `-C repo`; `exit-code` is 127 when `git` is not
  installed.
""")
exception GitError extends Exception
  args: array[text]
  exit-code: int
  stdout: text
  stderr: text

@doc("A commit's author or committer identity and timestamp.")
record Signature
  name: text
  email: text
  @doc("Unix epoch seconds.")
  time: decimal
  @doc("Git's `±HHMM` offset.")
  timezone: text

@doc("""
  A commit; `hash` is the full hash and `body` excludes the `subject` line.

  `body` has no trailing newline.
""")
record Commit
  hash: ref
  parents: array[ref]
  author: Signature
  committer: Signature
  subject: text
  body: text

@doc("How a path differs between two states; `similarity` is a percentage.")
enum Change
  | Unmodified
  | Added
  | Modified
  | Deleted
  | TypeChanged
  | Unmerged
  | Renamed(source: path, similarity: int)

@doc("A path and how it changed.")
record FileChange
  path: path
  change: Change

@doc("Added and deleted line counts of a path.")
record FileStat
  path: path
  @doc("`None` for a binary file, also one marked binary by attributes.")
  added: Option[int]
  @doc("`None` for a binary file, also one marked binary by attributes.")
  deleted: Option[int]

@doc("How the two sides of a conflict changed the path, from `ours` (current) and `theirs`.")
enum ConflictKind
  | BothModified
  | BothAdded
  | BothDeleted
  | AddedByUs
  | AddedByThem
  | DeletedByUs
  | DeletedByThem

@doc("""
  The state of a path in `Status`.

  `Tracked` gives the change staged in the index and the unstaged change in the work tree.
""")
enum EntryState
  | Tracked(staged: Change, unstaged: Change)
  | Conflict(kind: ConflictKind)
  | Untracked
  | Ignored

@doc("A path and its state.")
record StatusEntry
  path: path
  state: EntryState

@doc("Commits the branch has that its upstream lacks (`ahead`) and the reverse (`behind`).")
record Divergence
  ahead: int
  behind: int

@doc("The work tree's branch state and changed paths.")
record Status
  @doc("`None` on an unborn branch.")
  head: Option[ref]
  @doc("`None` when `HEAD` is detached.")
  branch: Option[ref]
  upstream: Option[ref]
  @doc("`None` without a live upstream.")
  divergence: Option[Divergence]
  entries: array[StatusEntry]

@doc("The two sides a diff compares; `base` defaults to `HEAD`.")
enum Diff
  | IndexToWorktree
  | CommitToIndex(base: ref = "HEAD")
  | CommitToWorktree(base: ref = "HEAD")
  | CommitToCommit(base: ref, target: ref)

@doc("An operation stopped on conflicts in `paths`, leaving the repository mid-operation.")
record Conflicted
  paths: array[path]

@doc("The result of an integrating operation; `head` is the new `HEAD`.")
enum Outcome
  | UpToDate
  | FastForwarded(head: ref)
  | Completed(head: ref)
  | ::Conflicted

@doc("The result of applying a stash entry.")
enum ApplyResult = Applied | ::Conflicted

@doc("A multi-step operation that can be in progress.")
enum Operation = Merging | Rebasing | CherryPicking | Reverting

@doc("Whether a merge may fast-forward: `Allow` when possible, `Only` or `Never`.")
enum FastForward = Allow | Only | Never

@doc("How `pull` integrates fetched commits.")
enum PullMode = Merge(ff: FastForward = Allow) | Rebase

@doc("What `reset` moves; `Keep` is `--keep`, a hard reset that preserves local changes.")
enum ResetMode = Soft | Mixed | Hard | Keep

@doc("Push overwrite policy; `WithLease` refuses when the remote ref moved unexpectedly.")
enum Force = NoForce | WithLease | Forced

@doc("The configuration file level.")
enum ConfigScope = Local | Global

@doc("Git's default peer for the current branch.")
record Upstream

@doc("What `fetch` retrieves; `AllRemotes` covers every remote, empty `refspecs` the defaults.")
enum FetchSource = ::Upstream | AllRemotes | FetchFrom(remote: text, refspecs: array[text] = [])

@doc("What `pull` integrates.")
enum PullSource = ::Upstream | PullFrom(remote: text, branch: ref)

@doc("Where `push` sends; empty `refspecs` use the defaults.")
enum PushTarget = ::Upstream | PushTo(remote: text, refspecs: array[text] = [])

@doc("A local or remote-tracking branch.")
record Branch
  @doc("`main`, or `origin/main` for a remote-tracking branch.")
  name: ref
  commit: ref
  @doc("The tracked branch, or `None` when it has none.")
  upstream: Option[ref]
  @doc("Whether the branch is checked out in this work tree.")
  current: bool

@doc("A stash entry.")
record StashEntry
  index: int
  @doc("`stash@{n}`.")
  name: ref
  commit: ref
  @doc("The reflog subject, e.g. `On main: wip`.")
  message: text

@doc("A work tree of the repository.")
record Worktree
  @doc("Absolute path.")
  path: path
  @doc("`None` for a bare entry.")
  head: Option[ref]
  @doc("`None` when detached or bare.")
  branch: Option[ref]
  bare: bool
  @doc("The lock reason, which may be empty.")
  locked: Option[text]
  @doc("The reason `worktree prune` would remove it, or `None` when it is not prunable.")
  prunable: Option[text]

@doc("A tag.")
record Tag
  name: ref
  @doc("The peeled object hash.")
  target: ref
  @doc("`Some` for an annotated tag.")
  message: Option[text]

@doc("A configured remote.")
record Remote
  name: text
  fetch-url: text
  push-url: text

scope GitInternals
  @doc("""
    The environment git runs in: ambient, with prompts and editors disabled and `GIT_DIFF_OPTS`,
    which overrides the diff context, cleared.
  """)
  def environment() -> std/env::Environ =
    std/env::environ.extended({
      "GIT_TERMINAL_PROMPT": "0",
      "GIT_EDITOR": "true",
      "GIT_DIFF_OPTS": "",
    })

  @doc("Run `git argv` and return its result, whatever the exit code.")
  def invoke(argv: array[text]) -> ExecResult =
    exec("git %{shell-join(argv)}", env = environment())

  @doc("Raise `GitError` for the failed `res` of `argv`.")
  def fail[T](argv: array[text], res: ExecResult) -> T =
    let command = shell-join(argv)
    raise GitError(
      argv,
      res.exit-code,
      res.stdout,
      res.stderr,
      message = "git %{command} failed with exit code %{res.exit-code}: %{res.stderr.trim()}",
    )

  @doc("Return `res` when it succeeded; otherwise raise `GitError` for `argv`.")
  def check(argv: array[text], res: ExecResult) -> ExecResult =
    if res.exit-code == 0 =>
      res
    else =>
      fail(argv, res)

  @doc("Return `args` prefixed with `-C repo`.")
  def scoped(repo: path, args: array[text]) -> array[text] = ["-C", repo].concat(args)

  @doc("Run git in `repo`, returning the result whatever the exit code.")
  def attempt(repo: path, args: array[text]) -> ExecResult = invoke(scoped(repo, args))

  @doc("Run git in `repo`; a nonzero exit raises `GitError`.")
  def run(repo: path, args: array[text]) -> ExecResult =
    let argv = scoped(repo, args)
    check(argv, invoke(argv))

  @doc("Run git without `-C`, for commands that create their own repository.")
  def run-unscoped(args: array[text]) -> ExecResult = check(args, invoke(args))

  @doc("""
    Run git in `repo`, mapping the documented negative exit code 1 to `None`.

    Any other nonzero exit raises `GitError`.
  """)
  def optional(repo: path, args: array[text]) -> Option[ExecResult] =
    let argv = scoped(repo, args)
    let res = invoke(argv)
    if res.exit-code == 1 =>
      None
    else =>
      Some(check(argv, res))

  @doc("""
    Return the literal root-relative pathspec for `p`.

    A path that normalizes to `.` is the whole tree.
  """)
  def pathspec(p: path) -> text =
    let normalized = std/path::normalize(p)
    if normalized == "." =>
      ":(top)"
    else =>
      ":(top,literal)" ++ normalized

  @doc("Map each path to its pathspec.")
  def pathspecs(paths: array[path]) -> array[text] = paths.map(pathspec)

  @doc("Return the pathspecs of `paths`, or the whole tree when `paths` is empty.")
  def tree-specs(paths: array[path]) -> array[text] =
    if paths.is-empty() =>
      [":(top)"]
    else =>
      pathspecs(paths)

  @doc("Remove one trailing newline.")
  def chomp(out: text) -> text =
    if out.ends-with("\n") =>
      out.slice(0, -1)
    else =>
      out

  @doc("Split NUL-terminated output into its records.")
  def split-nul(out: text) -> array[text] =
    let parts = out.split("\u0000")
    if parts.last() == "" =>
      parts.take(parts.size() - 1)
    else =>
      parts

  @doc("Group `items` into consecutive records of `size` items.")
  def chunks(items: array[text], size: int) -> array[array[text]] =
    var records: array[array[text]] = []
    var start = 0
    while start < items.size() do
      records.push(items.slice(start, start + size))
      start := start + size
    records

  @doc("Parse the text after the first character as an int, as in `+3` or `R100`.")
  def tail-int(code: text) -> int = code.slice(1, code.size()) as int

  @doc("""
    Decode a status letter; `source` and `similarity` apply to `R`.

    `U` is the only letter left, so it is the fallback: `C` and `B` cannot occur, as copy and
    break detection are never enabled.
  """)
  def change-of(letter: text, source: path, similarity: int) -> Change =
    case letter of
      | "." => Unmodified
      | "A" => Added
      | "M" => Modified
      | "D" => Deleted
      | "T" => TypeChanged
      | "R" => Renamed(source, similarity)
      | _ => Unmerged

  @doc("""
    Decode the `XY` code of an unmerged entry; git emits only seven.

    `UU` is the only code left, so it is the fallback.
  """)
  def conflict-kind-of(code: text) -> ConflictKind =
    case code of
      | "AA" => BothAdded
      | "DD" => BothDeleted
      | "AU" => AddedByUs
      | "UA" => AddedByThem
      | "DU" => DeletedByUs
      | "UD" => DeletedByThem
      | _ => BothModified

  @doc("Return the path in `fields` after the first `skip` fields, rejoining it with `sep`.")
  def field-path(fields: array[text], skip: int, sep: text = " ") -> path =
    join(fields.drop(skip), sep)

  @doc("""
    Build the entry of a tracked status line from its `XY` code.

    `source` and `similarity` describe the rename or copy of a `2` line.
  """)
  def tracked-entry(xy: text, p: path, source: path, similarity: int) -> StatusEntry =
    let staged = change-of(xy.slice(0, 1), source, similarity)
    let unstaged = change-of(xy.slice(1, 2), source, similarity)
    StatusEntry(p, Tracked(staged, unstaged))

  @doc("Return `Some(value)`, or `None` when `value` is git's `placeholder`.")
  def named(value: text, placeholder: text) -> Option[ref] =
    if value == placeholder =>
      None
    else =>
      Some(value)

  @doc("Parse `status --porcelain=v2 -z --branch` output.")
  def parse-status(out: text) -> Status =
    let items = split-nul(out)
    var head: Option[ref] = None
    var branch: Option[ref] = None
    var upstream: Option[ref] = None
    var divergence: Option[Divergence] = None
    var entries: array[StatusEntry] = []
    var i = 0
    while i < items.size() do
      let item = items[i]
      let fields = item.split(" ")
      case fields[0] of
        | "#" =>
          case fields[1] of
            | "branch.oid" => head := named(fields[2], "(initial)")
            | "branch.head" => branch := named(fields[2], "(detached)")
            | "branch.upstream" => upstream := Some(fields[2])
            | "branch.ab" =>
              divergence := Some(Divergence(tail-int(fields[2]), tail-int(fields[3])))
            | _ => ()
        | "1" => entries.push(tracked-entry(fields[1], field-path(fields, 8), "", 0))
        | "2" =>
          i := i + 1
          let entry = tracked-entry(fields[1], field-path(fields, 9), items[i], tail-int(fields[8]))
          entries.push(entry)
        | "u" =>
          entries.push(StatusEntry(field-path(fields, 10), Conflict(conflict-kind-of(fields[1]))))
        | "?" => entries.push(StatusEntry(item.slice(2, item.size()), Untracked))
        | "!" => entries.push(StatusEntry(item.slice(2, item.size()), Ignored))
        | _ => ()
      i := i + 1
    Status(head, branch, upstream, divergence, entries)

  @doc("The `log` format: one NUL-separated record of `log-fields` fields per commit.")
  def log-format() -> text =
    "--format=%H%x00%P%x00%an%x00%ae%x00%at%x00%ad%x00%cn%x00%ce%x00%ct%x00%cd%x00%s%x00%b"

  @doc("The number of fields `log-format` emits per commit.")
  def log-fields() -> int = log-format().split("%x00").size()

  @doc("Build a signature from its name, email, epoch-seconds, and `%z` offset fields.")
  def signature-of(fields: array[text]) -> Signature =
    Signature(fields[0], fields[1], fields[2] as decimal, fields[3])

  @doc("Remove all trailing newlines.")
  def trim-newlines(out: text) -> text =
    let trimmed = chomp(out)
    if trimmed == out =>
      out
    else =>
      trim-newlines(trimmed)

  @doc("Build a commit from one `log-format` record; only trailing newlines leave the body.")
  def commit-of(fields: array[text]) -> Commit =
    let parents = if fields[1].is-empty() => [] else => fields[1].split(" ")
    Commit(
      fields[0],
      parents,
      signature-of(fields.slice(2, 6)),
      signature-of(fields.slice(6, 10)),
      fields[10],
      trim-newlines(fields[11]),
    )

  @doc("""
    Return the commits `log` lists for `flags`, `revs`, and the pathspecs `specs`.

    The flags pin every setting the parser depends on, so user configuration cannot change the
    output: no color, signature, decoration, or `--follow` rename tracking, and UTF-8 text.
  """)
  def history(repo: path, flags: array[text], revs: array[ref],
              specs: array[text]) -> array[Commit] =
    let pinned = [
      "log",
      "-z",
      "--no-color",
      "--no-show-signature",
      "--no-decorate",
      "--no-follow",
      "--encoding=UTF-8",
      "--date=format:%z",
      log-format(),
    ]
    let args = pinned.concat(flags).concat(["--end-of-options"]).concat(revs).concat(["--"])
    let out = run(repo, args.concat(specs)).stdout
    chunks(split-nul(out), log-fields()).map(commit-of)

  @doc("The `diff` option that selects the two sides, before `--end-of-options`.")
  def diff-flags(sides: Diff) -> array[text] =
    case sides of
      | CommitToIndex(_) => ["--cached"]
      | _ => []

  @doc("""
    The commit operands that select the two sides of `sides`, as full hashes.

    Resolving them rejects what `diff` would read as other operands: a range or a tree.
  """)
  def diff-revs(repo: path, sides: Diff) -> array[ref] =
    case sides of
      | IndexToWorktree => []
      | CommitToIndex(base) => [resolve(base, repo)]
      | CommitToWorktree(base) => [resolve(base, repo)]
      | CommitToCommit(base, target) => [resolve(base, repo), resolve(target, repo)]

  @doc("""
    Return the stdout of `git diff` with `format` for `sides`, filtered to `paths`.

    The flags pin every setting that changes the parsed output or the patch's meaning, so user
    configuration cannot: no color, external diff, text conversion, or relative paths; `a/` and
    `b/` path prefixes; git's path order; submodule changes always shown, as commit ids; and
    renames, never copies, detected only when `renames`.
  """)
  def diff-output(repo: path, format: array[text], sides: Diff, paths: array[path],
                  renames: bool) -> text =
    let pinned = [
      "diff",
      "--no-color",
      "--no-ext-diff",
      "--no-textconv",
      "--no-relative",
      # An empty order file keeps git's path order, whatever `diff.orderFile` says.
      "-O/dev/null",
      "--src-prefix=a/",
      "--dst-prefix=b/",
      "--ignore-submodules=none",
      "--submodule=short",
      # `-M` also overrides a configured `diff.renames=copies`.
      if renames => "-M" else => "--no-renames",
    ]
    let args = pinned.concat(format)
      .concat(diff-flags(sides))
      .concat(["--end-of-options"])
      .concat(diff-revs(repo, sides))
      .concat(["--"])
      .concat(pathspecs(paths))
    run(repo, args).stdout

  # `C` (copy) and `B` (break) letters cannot occur: copy and break detection are never enabled,
  # so `change-of` falls back to `U` only for unmerged paths.
  @doc("Parse `diff --name-status -z` output; a rename lists its similarity, source, destination.")
  def parse-name-status(out: text) -> array[FileChange] =
    let items = split-nul(out)
    var changes: array[FileChange] = []
    var i = 0
    while i < items.size() do
      let code = items[i]
      if code.starts-with("R") =>
        changes.push(FileChange(items[i + 2], Renamed(items[i + 1], tail-int(code))))
        i := i + 3
      else =>
        changes.push(FileChange(items[i + 1], change-of(code, "", 0)))
        i := i + 2
    changes

  @doc("Return a `numstat` count, or `None` for git's `-` placeholder of a binary file.")
  def count-of(field: text) -> Option[int] =
    if field == "-" =>
      None
    else =>
      Some(field as int)

  @doc("""
    Parse `diff --numstat -z` output.

    A rename has an empty path field, followed by its source and destination records; it yields
    the destination.
  """)
  def parse-numstat(out: text) -> array[FileStat] =
    let items = split-nul(out)
    var stats: array[FileStat] = []
    var i = 0
    while i < items.size() do
      let fields = items[i].split("\t")
      let p = field-path(fields, 2, "\t")
      if p.is-empty() =>
        stats.push(FileStat(items[i + 2], count-of(fields[0]), count-of(fields[1])))
        i := i + 3
      else =>
        stats.push(FileStat(p, count-of(fields[0]), count-of(fields[1])))
        i := i + 1
    stats

  @doc("""
    Return the root-relative paths with unmerged index entries, in git's path order.

    A deleted-by-one-side path is included; the diff flags are pinned as for `diff-output`.
  """)
  def unmerged(repo: path) -> array[path] =
    let format = ["--name-only", "-z", "--diff-filter=U"]
    split-nul(diff-output(repo, format, IndexToWorktree, [], false))

  @doc("The git command that drives `op`.")
  def command-of(op: Operation) -> text =
    case op of
      | Merging => "merge"
      | Rebasing => "rebase"
      | CherryPicking => "cherry-pick"
      | Reverting => "revert"

  @doc("""
    Run git with `args` for the operation `op` and classify the result.

    Exit 0 is `Completed` when `resuming`; otherwise `UpToDate` when `HEAD` did not move,
    `FastForwarded` when it landed on `target`, else `Completed`. A nonzero exit is `Conflicted`
    only when `op` is left in progress with unmerged paths, and was not already in progress unless
    `resuming`; any other failure raises `GitError`. That keeps a refusal (dirty tree, another
    operation in progress, unmerged paths left by e.g. `stash apply`) from reading as a conflict.

    `rerere.autoUpdate` is overridden: it would stage a replayed resolution and so turn a conflict
    into a failure.
  """)
  def outcome(op: Operation, repo: path, args: array[text], target: Option[ref],
              resuming: bool) -> Outcome =
    let before: Option[ref] = if resuming => None else => resolve?("HEAD", repo)
    let fresh = if resuming => true else => operation(repo).is-none()
    let goal = target.map(fn(rev: ref) => resolve(rev, repo))
    let pinned = ["-c", "rerere.autoUpdate=false"].concat(args)
    let res = attempt(repo, pinned)
    if res.exit-code == 0 =>
      let after = resolve("HEAD", repo)
      if resuming =>
        Completed(after)
      else =>
        if before == Some(after) =>
          UpToDate
        else =>
          if goal == Some(after) =>
            FastForwarded(after)
          else =>
            Completed(after)
    else =>
      let paths = unmerged(repo)
      if not paths.is-empty() and (resuming or fresh) and operation(repo) == Some(op) =>
        Conflicted(paths)
      else =>
        fail(scoped(repo, pinned), res)

  @doc("""
    Replay `commits` with the git command of `op`, using `flags`, and classify the result.

    Each of `commits` is resolved first, so git reads none of them as an option or a range.
  """)
  def replay(op: Operation, flags: array[text], commits: array[ref], repo: path) -> Outcome =
    if commits.is-empty() =>
      UpToDate
    else =>
      let hashes = commits.map(fn(rev: ref) => resolve(rev, repo))
      let args = config-of(op)
        .concat([command-of(op)])
        .concat(flags)
        .concat(["--end-of-options"])
        .concat(hashes)
      outcome(op, repo, args, None, false)

  @doc("""
    The configuration that git commands of `op` are run with, in place of the user's.

    A merge or rebase commits with `commit.cleanup=scissors`: with no editing, that cleans up
    whitespace, keeps `#` lines, and drops everything from git's scissors line on. The sequencer of
    a cherry-pick or revert forces its own cleanup. A revert gets no `revert.reference` title.
  """)
  def config-of(op: Operation) -> array[text] =
    case op of
      | Merging => ["-c", "commit.cleanup=scissors"]
      | Rebasing => ["-c", "commit.cleanup=scissors"]
      | CherryPicking => []
      | Reverting => ["-c", "revert.reference=false"]

  @doc("The git arguments that continue `op`.")
  def continuation(op: Operation) -> array[text] =
    config-of(op).concat([command-of(op), "--continue"])

  @doc("""
    Return the operation whose command opens the sequencer todo file `todo`.

    Git writes `pick` for a cherry-pick and `revert` for a revert; an empty file gives `None`.
  """)
  def sequencer-operation(todo: path) -> Option[Operation] =
    case read(todo).split(" ")[0] of
      | "pick" => Some(CherryPicking)
      | "revert" => Some(Reverting)
      | _ => None

  @doc("The trailing `fetch` or `push` arguments naming `remote` (a name or URL) and `refspecs`.")
  def remote-operands(remote: text, refspecs: array[text]) -> array[text] =
    ["--end-of-options", remote].concat(refspecs)

  @doc("""
    Raise `GitError` unless the current branch has a configured upstream.

    The upstream counts even when its remote-tracking branch does not exist, as after a prune.
    Nothing is fetched.
  """)
  def require-upstream(repo: path) -> unit =
    let head = run(repo, ["symbolic-ref", "-q", "HEAD"]).stdout.trim()
    let args = ["for-each-ref", "--format=%(upstream)", head]
    let res = run(repo, args)
    if res.stdout.trim().is-empty() =>
      fail(scoped(repo, args), res)

  @doc("The `fetch` arguments that select `source`.")
  def fetch-selector(source: FetchSource) -> array[text] =
    case source of
      | Upstream => ["--no-all"]
      | AllRemotes => ["--all"]
      | FetchFrom(remote, refspecs) => remote-operands(remote, refspecs)

  @doc("""
    Fetch `source` into the repository of `repo`.

    Flags override the configuration that would change the outcome: submodules are not fetched,
    and `prune` is explicit. `Upstream` fetches one remote whatever `fetch.all` says.
  """)
  def fetch-from(repo: path, source: FetchSource, prune: bool, tags: bool) -> unit =
    let pruning = if prune => "--prune" else => "--no-prune"
    var args = ["fetch", "-q", "--no-recurse-submodules", "--no-prune-tags", pruning]
    if tags =>
      args.push("--tags")
    args.concat!(fetch-selector(source))
    let _ = run(repo, args)
end GitInternals

@doc("""
  Check if `repo` is inside a work tree.

  A bare repository, a git directory, or any failure is `false`.
""")
def is-repo(repo: path = ".") -> bool =
  let res = GitInternals::attempt(repo, ["rev-parse", "--is-inside-work-tree"])
  res.exit-code == 0 and res.stdout.trim() == "true"

@doc("""
  Return the absolute root of the work tree containing `repo`.

  Raises `GitError` when `repo` is not inside a work tree.
""")
def root(repo: path = ".") -> path =
  GitInternals::chomp(GitInternals::run(repo, ["rev-parse", "--show-toplevel"]).stdout)

@doc("""
  Create a repository at `repo`, with `branch` as its initial branch when given.

  A `bare` repository has no work tree.
""")
def init(repo: path = ".", branch: Option[ref] = None, bare: bool = false) -> unit =
  var args = ["init", "-q"]
  case branch of
    | Some(value) => args.push("--initial-branch=%{value}")
    | None => ()
  if bare =>
    args.push("--bare")
  args.concat!(["--end-of-options", repo])
  let _ = GitInternals::run-unscoped(args)

@doc("""
  Clone `url` into `repo`.

  `branch` checks out that branch, `depth` makes a shallow clone, and `bare` omits the work tree.
""")
def clone(url: text, repo: path, branch: Option[ref] = None, depth: Option[int] = None,
          bare: bool = false) -> unit =
  var args = ["clone", "-q"]
  case branch of
    | Some(value) => args.push("--branch=%{value}")
    | None => ()
  case depth of
    | Some(value) => args.concat!(["--no-local", "--depth=%{value}"])
    | None => ()
  if bare =>
    args.push("--bare")
  args.concat!(["--end-of-options", url, repo])
  let _ = GitInternals::run-unscoped(args)

@doc("Return the tracked files under `paths`, or all of them when `paths` is empty.")
def files(paths: array[path] = [], repo: path = ".") -> array[path] =
  let base = ["ls-files", "-z", "--full-name", "--deduplicate", "--"]
  let args = base.concat(GitInternals::tree-specs(paths))
  GitInternals::split-nul(GitInternals::run(repo, args).stdout)

@doc("""
  Return the full hash of the commit `rev` names.

  Raises `GitError` when `rev` does not name a commit, as for a range, a negated revision, or a
  tree.
""")
def resolve(rev: ref, repo: path = ".") -> ref =
  # One-argument `merge-base --octopus` prints the commit `rev` names and rejects ranges, negations
  # and non-commits, unlike `rev-parse --verify`, which accepts a negated `^rev`.
  GitInternals::run(repo, ["merge-base", "--octopus", "--end-of-options", rev]).stdout.trim()

@doc("""
  Return the full hash of the commit `rev` names, or `None` when it names none, as for a negated
  revision. A `:/text` search is not supported.
""")
def resolve?(rev: ref, repo: path = ".") -> Option[ref] =
  let args = ["rev-parse", "-q", "--verify", "--end-of-options", rev ++ "^{commit}"]
  GitInternals::optional(repo, args)
    .map(fn(res: ExecResult) => res.stdout.trim())
    .select(fn(hash: ref) => not hash.starts-with("^"))

@doc("""
  Return the commits reachable from `include` but not from `exclude`, in git's default order
  (newest first).

  `paths` keeps the commits that change them, `max-count` caps the count, and `first-parent`
  follows only the first parent of merges. Empty `include` and `exclude` list `HEAD`.

  Each `include` and `exclude` entry names a single revision, which must peel to a commit.

  A `:/text` search is not supported.

  Raises `GitError` when a revision names no commit.
""")
def log(include: array[ref] = ["HEAD"], exclude: array[ref] = [], paths: array[path] = [],
        max-count: Option[int] = None, first-parent: bool = false,
        repo: path = ".") -> array[Commit] =
  var flags: array[text] = []
  case max-count of
    | Some(value) => flags.push("--max-count=%{value}")
    | None => ()
  if first-parent =>
    flags.push("--first-parent")
  # Without `^{commit}`, tree and blob revisions exit 0 with silently wrong results.
  let revs = include.map(fn(rev: ref) => rev ++ "^{commit}")
    .concat(exclude.map(fn(rev: ref) => "^" ++ rev ++ "^{commit}"))
  GitInternals::history(repo, flags, revs, GitInternals::pathspecs(paths))

@doc("""
  Return the commit `rev` names, without its ancestors.

  Raises `GitError` when `rev` does not name a commit, as for a range or a tree.
""")
def show(rev: ref = "HEAD", repo: path = ".") -> Commit =
  GitInternals::history(repo, ["--max-count=1", "--no-walk"], [resolve(rev, repo)], [])[0]

@doc("""
  Return the content of the file `path` at `rev`, verbatim.

  `path` is relative to the repository root, and `rev` must not contain `:`.

  Raises `GitError` when `rev` or `path` does not exist, `path` is not a file, or `path` leaves
  the tree. A file that is not valid UTF-8 raises `ExecError`.
""")
def read-file(path: path, rev: ref = "HEAD", repo: path = ".") -> text =
  # `-C root(repo)`: `rev:../p` resolves relative to the current directory, so from a subdirectory
  # it would escape the tree silently.
  let spec = "%{rev}:%{std/path::normalize(path)}"
  GitInternals::run(root(repo), ["cat-file", "blob", "--end-of-options", spec]).stdout

@doc("""
  Return the best common ancestor of `a` and `b`, or `None` when their histories are unrelated.

  Raises `GitError` when a revision names no commit.
""")
def merge-base(a: ref, b: ref, repo: path = ".") -> Option[ref] =
  let args = ["merge-base", "--end-of-options", a, b]
  GitInternals::optional(repo, args).map(fn(res: ExecResult) => res.stdout.trim())

@doc("""
  Check if `ancestor` is reachable from `descendant`; a commit is its own ancestor.

  Raises `GitError` when a revision names no commit.
""")
def is-ancestor(ancestor: ref, descendant: ref, repo: path = ".") -> bool =
  let args = ["merge-base", "--is-ancestor", "--end-of-options", ancestor, descendant]
  GitInternals::optional(repo, args).is-some()

@doc("""
  Return the files that differ between the two `sides`, in git's path order.

  `paths` keeps the matching files, and `renames` detects renames, whose source and similarity
  `Renamed` carries; copies are never detected. A rename is detected only when `paths` keep both
  its paths. A conflicted path is `Unmerged`, and `IndexToWorktree` may list it a second time with
  its own work tree change. Untracked files are not compared.

  Raises `GitError` when a `base` or `target` revision names no commit, as for a range or a
  tree.
""")
def diff(sides: Diff = IndexToWorktree, paths: array[path] = [], renames: bool = true,
         repo: path = ".") -> array[FileChange] =
  let out = GitInternals::diff-output(repo, ["--name-status", "-z"], sides, paths, renames)
  GitInternals::parse-name-status(out)

@doc("""
  Return the added and deleted line counts of the files that differ between the two `sides`.

  A renamed file is listed under its destination path. An unmerged path counts 0 and 0, and
  `IndexToWorktree` may list it a second time with its own work tree counts. The arguments are as
  for `diff`.

  Raises `GitError` when a revision names no commit.
""")
def diff-stat(sides: Diff = IndexToWorktree, paths: array[path] = [], renames: bool = true,
              repo: path = ".") -> array[FileStat] =
  let out = GitInternals::diff-output(repo, ["--numstat", "-z"], sides, paths, renames)
  GitInternals::parse-numstat(out)

@doc("""
  Return the unified diff between the two `sides`, verbatim, with `context` lines around changes.

  A binary file appears as a `Binary files … differ` line. The arguments are as for `diff`,
  treating a negative `context` as zero.

  Raises `GitError` when a revision names no commit; a diff that is not valid UTF-8 raises
  `ExecError`.
""")
def patch(sides: Diff = IndexToWorktree, paths: array[path] = [], context: int = 3,
          renames: bool = true, repo: path = ".") -> text =
  # Settings that only change layout stay unpinned, as the patch remains applicable:
  # `diff.interHunkContext`, `diff.indentHeuristic`, `diff.algorithm`, `diff.suppressBlankEmpty`,
  # and `core.quotePath` (header quoting).
  let lines = if context < 0 => 0 else => context
  GitInternals::diff-output(repo, ["-U%{lines}"], sides, paths, renames)

@doc("""
  Return the branch state and changed paths of the work tree containing `repo`.

  `untracked` includes untracked files individually; `ignored` includes ignored files, an ignored
  directory as `dir/`. Paths are root-relative. Staged renames are detected, copies are not.
""")
def status(untracked: bool = true, ignored: bool = false, repo: path = ".") -> Status =
  # `--ignored` needs untracked scanning, so untracked entries are dropped afterwards.
  let scan = if untracked or ignored => "all" else => "no"
  let mode = if ignored => "matching" else => "no"
  # `--no-renames` resets configured copy detection, `--find-renames` then enables renames only;
  # `--ignore-submodules=none` overrides configured submodule hiding.
  let args = [
    "status",
    "--porcelain=v2",
    "-z",
    "--branch",
    "--no-renames",
    "--find-renames",
    "--ignore-submodules=none",
    "--untracked-files=%{scan}",
    "--ignored=%{mode}",
  ]
  let parsed = GitInternals::parse-status(GitInternals::run(repo, args).stdout)
  if untracked =>
    parsed
  else =>
    let kept = parsed.entries.select(fn(e: StatusEntry) => e.state is not Untracked)
    parsed with entries = kept

@doc("Check if the work tree has no changes; `untracked` counts untracked files as changes.")
def is-clean(untracked: bool = true, repo: path = ".") -> bool =
  status(untracked, false, repo).entries.is-empty()

@doc("""
  Stage `paths`, deletions included; `"."` stages the whole tree.

  Does nothing for no paths. Raises `GitError` for an ignored or missing path.
""")
def add(paths: array[path], repo: path = ".") -> unit =
  if not paths.is-empty() =>
    let _ = GitInternals::run(repo, ["add", "--"].concat(GitInternals::pathspecs(paths)))

@doc("""
  Remove `paths` from the index and the work tree, directories recursively.

  `cached` keeps the files on disk; `force` also removes files with local modifications. Does
  nothing for no paths. Raises `GitError` for an untracked path or a modified file without `force`.
""")
def remove(paths: array[path], cached: bool = false, force: bool = false,
           repo: path = ".") -> unit =
  if not paths.is-empty() =>
    var args = ["rm", "-q", "-r"]
    if cached =>
      args.push("--cached")
    if force =>
      args.push("-f")
    args.push("--")
    args.concat!(GitInternals::pathspecs(paths))
    let _ = GitInternals::run(repo, args)

@doc("""
  Move or rename the tracked path `source` to `destination`, both relative to the work-tree root.

  An existing directory `destination` receives `source`. Raises `GitError` when git refuses the
  move.
""")
def move(source: path, destination: path, repo: path = ".") -> unit =
  let _ = GitInternals::run(root(repo), ["mv", "--", source, destination])

@doc("""
  Commit the index with `message`, and return the new `HEAD`.

  `all` first stages modifications and deletions of tracked files, `amend` replaces the last
  commit, `allow-empty` permits a commit without changes, and `verify` runs the pre-commit and
  commit-msg hooks. Whitespace in `message` is cleaned up; `#` lines are kept.

  Raises `GitError` when there is nothing to commit or a hook fails.
""")
def commit(message: text, all: bool = false, amend: bool = false, allow-empty: bool = false,
           verify: bool = true, repo: path = ".") -> ref =
  var args = ["commit", "-q", "--cleanup=whitespace", "-m", message]
  if all =>
    args.push("--all")
  if amend =>
    args.push("--amend")
  if allow-empty =>
    args.push("--allow-empty")
  if not verify =>
    args.push("--no-verify")
  let _ = GitInternals::run(repo, args)
  resolve("HEAD", repo)

@doc("""
  Switch to `target`: the local branch of that name when there is one, else a detached `HEAD` at
  the commit it names.

  A `target` that is not a local branch, `"HEAD"` included, detaches.

  Raises `GitError` when `target` names no commit or local changes would be overwritten.
""")
def checkout(target: ref, repo: path = ".") -> unit =
  let mode = if branch::exists(target, repo) => "--no-guess" else => "--detach"
  let _ = GitInternals::run(repo, ["switch", "-q", mode, "--end-of-options", target])

@doc("""
  Restore `paths` in the work tree from the index, or with a `source` in the index and the work
  tree from that commit.

  A path in the index but absent from `source` is deleted from the index and the work tree.

  Does nothing for no paths. Raises `GitError` when a path matches nothing in the index or
  `source`.
""")
def checkout-files(paths: array[path], source: Option[ref] = None, repo: path = ".") -> unit =
  if not paths.is-empty() =>
    var args = ["restore"]
    case source of
      | Some(value) => args.concat!(["--source=%{value}", "--staged", "--worktree"])
      | None => args.push("--worktree")
    args.push("--")
    args.concat!(GitInternals::pathspecs(paths))
    let _ = GitInternals::run(repo, args)

@doc("""
  Move the current branch to the commit `target` names, as far as `mode` says.

  `Soft` keeps the index and work tree, `Mixed` resets the index, `Hard` the work tree too, and
  `Keep` the work tree except for local changes.

  Raises `GitError` when `target` names no commit or `Keep` would lose local changes.
""")
def reset(target: ref = "HEAD", mode: ResetMode = Mixed, repo: path = ".") -> unit =
  let flag = case mode of
    | Soft => "--soft"
    | Mixed => "--mixed"
    | Hard => "--hard"
    | Keep => "--keep"
  let _ = GitInternals::run(repo, ["reset", "-q", flag, resolve(target, repo), "--"])

@doc("""
  Reset the index entries of `paths` to the commit `source` names, leaving the work tree alone.

  A path absent from `source` is unstaged, leaving the file as an untracked addition.

  Does nothing for no paths. Raises `GitError` when `source` names no commit or a path matches
  nothing in the index or `source`.
""")
def reset-files(paths: array[path], source: ref = "HEAD", repo: path = ".") -> unit =
  if not paths.is-empty() =>
    let args = ["restore", "--staged", "--source=%{source}", "--"]
    let _ = GitInternals::run(repo, args.concat(GitInternals::pathspecs(paths)))

@doc("""
  Delete untracked files under `paths`, or in the whole tree when `paths` is empty.

  `ignored` also deletes ignored files. `directories` includes untracked directories, but only
  when `paths` is empty: with `paths`, untracked directories at or under them are deleted
  regardless.
""")
def clean(paths: array[path] = [], directories: bool = true, ignored: bool = false,
          repo: path = ".") -> unit =
  var args = ["clean", "-f", "-q"]
  if directories =>
    args.push("-d")
  if ignored =>
    args.push("-x")
  # Git ignores `-d` when given a pathspec, so the whole tree is cleaned from the root with none.
  if paths.is-empty() =>
    let _ = GitInternals::run(root(repo), args)
  else =>
    let _ = GitInternals::run(repo, args.concat(["--"]).concat(GitInternals::tree-specs(paths)))

@doc("""
  Merge the commit `target` names into the current branch.

  `ff` says whether to fast-forward when possible (`Allow`), only fast-forward (`Only`), or always
  create a merge commit (`Never`); `message` is the merge commit's message, with whitespace cleaned
  up. Its `#` lines are kept, also by `resume(Merging)` after a conflict. Local configuration of
  these, of autostashing and of the merge log summary is overridden.

  A conflict leaves the merge in progress: resolve the paths, `add` them, and `resume(Merging)`, or
  `abort(Merging)`.

  Raises `GitError` when `target` names no commit, `Only` cannot fast-forward, or git refuses, as
  for local changes the merge would overwrite or an operation already in progress. An error after
  the merge started may leave it in progress; see `operation`.
""")
def merge(target: ref, ff: FastForward = Allow, message: Option[text] = None,
          repo: path = ".") -> Outcome =
  let mode = case ff of
    | Allow => "--ff"
    | Only => "--ff-only"
    | Never => "--no-ff"
  var args = ["merge", "--no-edit", "--no-log", "--no-autostash", "--cleanup=scissors", mode]
  case message of
    | Some(value) => args.concat!(["-m", value])
    | None => ()
  args.concat!(["--end-of-options", target])
  GitInternals::outcome(Merging, repo, args, Some(target), false)

@doc("""
  Replay the commits of the current branch that `onto` lacks on top of the commit `onto` names.

  Commits already in `onto` are dropped, and merge commits are flattened. Replayed messages get
  whitespace cleanup and keep their `#` lines. A conflict leaves the rebase in progress: resolve
  the paths, `add` them, and `resume(Rebasing)`, or `abort(Rebasing)`. Local configuration of
  autostashing, the backend, ref updating, merge rebasing and message cleanup is overridden.

  Raises `GitError` when `onto` names no commit or git refuses, as for local changes or an operation
  already in progress. An error after the rebase started, as for an untracked file a replayed commit
  would overwrite, may leave it in progress; see `operation`.
""")
def rebase(onto: ref, repo: path = ".") -> Outcome =
  let pins = ["-c", "rebase.updateRefs=false", "-c", "rebase.rebaseMerges=false"]
  let flags = ["rebase", "-q", "--merge", "--no-autostash", "--end-of-options", onto]
  let args = pins.concat(GitInternals::config-of(Rebasing)).concat(flags)
  GitInternals::outcome(Rebasing, repo, args, Some(onto), false)

@doc("""
  Apply the changes of `commits`, in order, as new commits on the current branch.

  Each keeps the message of its original, verbatim.

  Does nothing for no commits. Each of them names a single commit, not a range. A conflict leaves
  the pick in progress: resolve the paths, `add` them, and `resume(CherryPicking)` to continue with
  the remaining commits, or `abort(CherryPicking)`. A commit that `resume` commits after a conflict
  has its `#` lines removed, as git's sequencer always strips them.

  Raises `GitError` when a commit is not a commit, is a merge, or git refuses, as for local changes
  or an operation already in progress. A commit whose changes `HEAD` already has stops the pick as
  an error, leaving it in progress to `abort`. Any error after the pick started may leave it in
  progress; see `operation`.
""")
def cherry-pick(commits: array[ref], repo: path = ".") -> Outcome =
  GitInternals::replay(CherryPicking, ["--cleanup=verbatim"], commits, repo)

@doc("""
  Undo the changes of `commits`, in order, with new commits on the current branch.

  The arguments, conflicts and errors are as for `cherry-pick`, with `Reverting` in place of
  `CherryPicking`. Local configuration of the reverted commit reference is overridden.
""")
def revert(commits: array[ref], repo: path = ".") -> Outcome =
  GitInternals::replay(Reverting, ["--no-edit"], commits, repo)

@doc("""
  Return the operation in progress in the work tree containing `repo`, if any.

  Precedence is rebase, merge, cherry-pick, revert. A multi-commit cherry-pick or revert that
  stopped without a conflict is found from the first command of its sequencer. A linked work tree
  has its own state. Detection reads git's state files, so it assumes the files ref backend: the
  reftable backend keeps `CHERRY_PICK_HEAD` and `REVERT_HEAD` as refs.

  Raises `GitError` when `repo` is not inside a repository.
""")
def operation(repo: path = ".") -> Option[Operation] =
  let states: array[Pair[text, Operation]] = [
    Pair::[text, Operation]("rebase-merge", Rebasing),
    Pair::[text, Operation]("rebase-apply", Rebasing),
    Pair::[text, Operation]("MERGE_HEAD", Merging),
    Pair::[text, Operation]("CHERRY_PICK_HEAD", CherryPicking),
    Pair::[text, Operation]("REVERT_HEAD", Reverting),
  ]
  var args = ["rev-parse", "--path-format=absolute", "--git-path", "sequencer/todo"]
  for state in states do
    args.concat!(["--git-path", state.first])
  let paths = GitInternals::run(repo, args).stdout.split("\n")
  let found = states.zip(paths.drop(1)).find(fn(entry: Pair[Pair[text, Operation], text]) =>
    exists(entry.second))
  case found of
    | Some(value) => Some(value.first.second)
    | None =>
      if exists(paths[0]) =>
        GitInternals::sequencer-operation(paths[0])
      else =>
        None

@doc("""
  Abandon the `operation` in progress and restore the state before it started.

  `CherryPicking` and `Reverting` abort either sequencer operation. A cherry-pick or revert of
  several commits whose `HEAD` was moved manually is ended without being rewound. A `git am`
  session is reported by `operation` as `Rebasing`, but `abort(Rebasing)` cannot abort it.

  Raises `GitError` when `operation` is not in progress or git refuses.
""")
def abort(operation: Operation, repo: path = ".") -> unit =
  let _ = GitInternals::run(repo, [GitInternals::command-of(operation), "--abort"])

@doc("""
  Continue the `operation` in progress after its conflicts are resolved and `add`ed.

  Returns `Completed` once it finishes, or `Conflicted` when paths are still unresolved or the next
  commit conflicts. A rebase drops a commit that the resolution emptied.

  The message of a merge or rebase commit is whitespace-cleaned, keeping its `#` lines whatever
  `commit.cleanup` says, but truncated at git's scissors line:
  `# ------------------------ >8 ------------------------`. A merge that `merge` did not start
  keeps the `# Conflicts:` comment lines git added.

  Raises `GitError` when `operation` is not in progress or git refuses, as for a cherry-pick or
  revert commit emptied by the resolution, which stays in progress to `abort`. `CherryPicking` and
  `Reverting` share git's sequencer: give the one `operation` reports. With the other, a single
  pending commit may be completed, while several raise `GitError`.
""")
def resume(operation: Operation, repo: path = ".") -> Outcome =
  GitInternals::outcome(operation, repo, GitInternals::continuation(operation), None, true)

@doc("""
  Download the objects and refs `source` names, without changing the work tree or any local
  branch.

  `Upstream` fetches the remote of the current branch, else `origin`; `AllRemotes` fetches every
  remote; `FetchFrom` fetches the remote `remote` (a name or URL) with the `refspecs` given, or
  its configured ones. `prune` deletes the local refs, mapped by the refspecs, that the remote no
  longer has: remote-tracking branches, and tags only when a refspec, explicit or configured (as
  in mirror clones), names them. `tags` fetches every tag; otherwise only the tags on fetched history are followed, as the
  remote's `tagOpt` says. Submodules are not fetched. Configuration of pruning is overridden.

  Raises `GitError` when git cannot fetch, as for an unknown remote or refspec, or a remote it
  cannot reach or authenticate with: git's terminal prompts are off, credential helpers are used.
""")
def fetch(source: FetchSource = Upstream, prune: bool = false, tags: bool = false,
          repo: path = ".") -> unit =
  GitInternals::fetch-from(repo, source, prune, tags)

@doc("""
  Fetch, then merge or rebase the current branch onto the fetched commit, as `mode` says.

  `Upstream` fetches as `fetch` does and integrates the upstream branch; `PullFrom` fetches just
  `branch` of the remote `remote` and integrates it, whether or not it is the upstream. The
  integration is `merge` or `rebase`, so the `Outcome` is theirs, `Conflicted` included, and
  `pull.rebase`, `pull.ff` and `branch.<name>.rebase` do not apply.

  Raises `GitError` when `Upstream` finds no upstream branch, `branch` is not a plain ref name or
  is missing on the remote, or git refuses to fetch, merge or rebase, as for local changes the
  integration would overwrite. An invalid `branch` and a missing upstream fail before any fetch;
  any other error comes after it. An error after the integration started may leave it in
  progress; see `operation`.
""")
def pull(source: PullSource = Upstream, mode: PullMode = Merge(Allow),
         repo: path = ".") -> Outcome =
  let target = case source of
    | Upstream =>
      GitInternals::require-upstream(repo)
      GitInternals::fetch-from(repo, Upstream, false, false)
      "@{upstream}"
    | PullFrom(remote, branch) =>
      # A refspec in `branch` would update local refs; `refs/` makes a plain name a valid ref.
      let _ = GitInternals::run(repo, ["check-ref-format", "refs/" ++ branch])
      GitInternals::fetch-from(repo, FetchFrom(remote, [branch]), false, false)
      "FETCH_HEAD"
  case mode of
    | Merge(ff) => merge(target, ff, None, repo)
    | Rebase => rebase(target, repo)

@doc("""
  Send commits to a remote, as `target` says.

  `Upstream` pushes the current branch to its upstream branch, whatever its name, even when the
  remote-tracking branch is gone; as git does with no refspecs, the remote's configured push
  refspecs (`remote.<r>.push`) and mirror setting (`remote.<r>.mirror`) still apply. `PushTo`
  pushes the `refspecs` to the remote `remote` (a name or URL); with none, it pushes the current
  branch to the branch of the same name, or as the remote's configured refspecs or mirror setting
  say. `WithLease` overwrites remote history only if the remote-tracking branch still matches
  the remote, so it overwrites commits fetched but not integrated; `Forced` overwrites
  regardless. `set-upstream` makes the pushed
  branch track its remote branch. `tags` also pushes every tag, and without `refspecs`, as for
  `Upstream`, only the tags. Configuration of the default push, followed tags, signing,
  force-if-includes and submodules is overridden; `push.autoSetupRemote` still sets the upstream
  when `PushTo` without `refspecs` pushes a new branch.

  Raises `GitError` when `Upstream` finds no upstream branch, or `remote.pushDefault` or
  `branch.<name>.pushRemote` names another remote, or the remote refuses the update, as for a
  non-fast-forward without force, or git cannot reach or authenticate with it: terminal prompts
  are off, credential helpers are used.
""")
def push(target: PushTarget = Upstream, force: Force = NoForce, set-upstream: bool = false,
         tags: bool = false, repo: path = ".") -> unit =
  var default = "upstream"
  var operands: array[text] = []
  case target of
    | Upstream =>
      # With `push.autoSetupRemote` git would create a missing upstream; no flag prevents that.
      GitInternals::require-upstream(repo)
    | PushTo(remote, refspecs) =>
      default := "current"
      operands := GitInternals::remote-operands(remote, refspecs)
  # An empty `push.pushOption` resets the list: the remote need not support push options.
  var args = [
    "-c", "push.default=%{default}", "-c", "push.pushOption=", "push", "-q", "--no-follow-tags",
    "--no-signed", "--no-recurse-submodules",
  ]
  case force of
    | NoForce => ()
    | WithLease => args.concat!(["--force-with-lease", "--no-force-if-includes"])
    | Forced => args.push("--force")
  if set-upstream =>
    args.push("--set-upstream")
  if tags =>
    args.push("--tags")
  args.concat!(operands)
  let _ = GitInternals::run(repo, args)

scope branch
  @doc("Check if the local branch `name` exists; a tag or remote-tracking name is not one.")
  def exists(name: ref, repo: path = ".") -> bool =
    let args = ["show-ref", "--verify", "-q", "--end-of-options", "refs/heads/%{name}"]
    GitInternals::optional(repo, args).is-some()
end branch
