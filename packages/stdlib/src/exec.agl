import std/array
import std/config
import std/env::Environ
import std/errors::Exception
import std/option::Option
import std/path::path
import std/sandbox::Sandbox
import std/text::{join, ++}

builtin
record ExecResult
  stdout: text
  exit-code: int
  stderr: text
  timed-out: bool

# `stdout`/`stderr` is "" for a stream that was captured but is not valid
# UTF-8; the message names the stream and the offending byte offset.
builtin
exception ExecError extends Exception
  command: text
  exit-code: int
  stdout: text
  stderr: text
  timed-out: bool

@doc("""
  Run a shell command and return its captured output and exit status.

  `T` defaults to `ExecResult`. For any other `T`, stdout is parsed into it, shaped by `format`,
  `strict-json` and `parse-error-retries`; those options apply only to a parsed target.

  Non-zero exit statuses are returned in `ExecResult`. Raises `ExecError` on spawn or sandbox
  preparation failure, timeout, or invalid UTF-8 output; raises `TypeError` for an invalid timeout.
""")
builtin def exec[T](
  command: text,
  env: Environ = std/env::environ,
  cwd: Option[path] = None,
  timeout: Option[text] = std/config::timeout,
  sandbox: Option[Sandbox] = None,
  format: text = "",
  strict-json: bool = false,
  parse-error-retries: int = 0,
) -> T

@shell-quoted
@doc("Quote text as one literal POSIX shell word: single-quoted, each `'` written as `'\\''`.")
def shell-quote(value: text) -> text = "'" ++ value.replace("'", "'\\''") ++ "'"

@shell-quoted
@doc("Quote each value with `shell-quote` and join them with spaces, one shell word per value.")
def shell-join(values: array[text]) -> text = join(values.map(shell-quote), " ")

@exempts("unquoted-exec-hole")
@doc("Return `value` unchanged, marking a deliberate unquoted splice into a shell command.")
def shell-raw(value: text) -> text = value
