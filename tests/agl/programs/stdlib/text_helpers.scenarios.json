      "expect": {
        "stdout": "[]\n[\"one\"]\n[\"one\", \"two\"]\n[\"one\", \"two\"]\n[\"\"]\n[\"\", \"a\", \"\"]\n[\"a\\nb\", \"é😀\"]\n",
        "calls": {}
