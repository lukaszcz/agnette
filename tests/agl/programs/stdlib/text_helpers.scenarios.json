        "stdout": "[\"\", \"plain\", \"\", \"é😀\\n\", \" leading \\n \", \"x\\r\", \"x\\ny\"]\n[\"\", \"plain\", \"\", \"é😀\", \" leading \\n \", \"x\\r\", \"x\\ny\"]\nx\n",
        "calls": {}
      }
    },
    {
      "name": "without_prefix_removes_one_literal_unicode_prefix",
      "params": {"mode": 2},
      "expect": {"stdout": "tail\nprefix\ntext\ntext\n\n\n", "calls": {}}
