    {
      "name": "scalars_and_arrays_are_rendered_then_quoted",
      "params": {
        "value": "",
        "mode": 2
      },
      "shell": [
        {
          "command": "echo '42' '-7' '1.5' 'true'"
        },
        {
          "command": "echo '[1, 2, 3]' '[\"a b\", \"it'\\''s\"]' '[]'"
        }
      ],
      "expect": {
        "stdout": ""
      }
    },
    {
      "name": "join_and_raw_compose_with_quoted_holes",
      "params": {
        "value": "a b",
        "mode": 3
      },
      "shell": [
        {
          "command": "'ls' '-la' 'my dir' 'it'\\''s' ''"
        },
        {
          "command": "''\\''ls'\\'' '\\''-la'\\'' '\\''my dir'\\'' '\\''it'\\''\\'\\'''\\''s'\\'' '\\'''\\'''"
        },
        {
          "command": "echo a b 'a b'"
        }
      ],
      "expect": {
        "stdout": ""
      }
    },
    {
      "name": "quoted_environment_holes",
      "params": {
        "value": "",
        "mode": 4
      },
      "process_environment": {
        "HOME": "/home/me y",
        "USER": "o'neil"
      },
      "shell": [
        {
          "command": "echo '/home/me y' /home/me y 'o'\\''neil'",
          "env": {
            "HOME": "/home/me y",
            "USER": "o'neil"
          }
        },
        {
          "command": "echo '/home/me y'",
          "env": {
            "HOME": "/home/me y",
            "USER": "o'neil"
          }
        },
        {
          "command": "echo '/home/me y'",
          "env": {
            "HOME": "/home/me y",
            "USER": "o'neil"
          }
        }
      ],
      "expect": {
        "stdout": ""
      }
    },
    {
