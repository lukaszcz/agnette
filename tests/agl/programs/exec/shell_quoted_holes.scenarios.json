        {
          "command": "printf %s 'it'\\''s'"
        },
        {
          "command": "printf %s 'it'\\''s'"
        },
        {
          "command": "printf %s 'it'\\''s'\necho done"
        }
      ],
      "expect": {
        "stdout": ""
      }
    },
