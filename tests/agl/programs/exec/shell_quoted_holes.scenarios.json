    {
      "name": "adjacent_escaped_and_malformed_openers",
      "params": {
        "value": "v w",
        "mode": 6
      },
      "shell": [
        {
          "command": "echo 'v w''v w'v wx"
        },
        {
          "command": "echo %!{value} %!${HOME} %!${} %!x %! {value} %!"
        },
        {
          "command": "echo %!{value} %!${HOME} %!${} %!x %!"
        }
      ],
      "expect": {
        "stdout": ""
      }
    },
    {
      "name": "plain_and_quoted_holes_mix_in_one_command",
      "params": {
        "value": "v w",
        "mode": 7
      },
      "process_environment": {
        "HOME": "/h m"
      },
      "shell": [
        {
          "command": "echo 'v w' /h m '/h m'",
          "env": {
            "HOME": "/h m"
          }
        }
      ],
      "expect": {
        "stdout": ""
