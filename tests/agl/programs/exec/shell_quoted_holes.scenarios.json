        "mode": 5
      },
      "shell": [
        {
          "command": "echo 'x'"
        },
        {
          "command": "echo 'ex'"
        },
        {
          "command": "echo 'x'"
        },
        {
          "command": "echo 'x'!"
        }
      ],
      "expect": {
        "stdout": ""
      }
    },
    {
      "name": "quoted_holes_over_if_and_case_apostrophe",
      "params": {
        "value": "it's",
        "mode": 5
      },
      "shell": [
        {
          "command": "echo 'it'\\''s'"
