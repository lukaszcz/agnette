{
  "scenarios": [
    {
      "name": "quoted_hole_in_every_template_form_plain",
      "params": {
        "value": "plain",
        "mode": 1
      },
      "shell": [
        {
          "command": "printf %s 'plain'"
        },
        {
          "command": "printf %s 'plain'"
        },
        {
          "command": "printf %s 'plain'"
        },
        {
          "command": "printf %s 'plain'\necho done"
        }
      ],
      "expect": {
        "stdout": ""
      }
    },
    {
      "name": "quoted_hole_in_every_template_form_space",
      "params": {
        "value": "a b",
        "mode": 1
      },
      "shell": [
        {
          "command": "printf %s 'a b'"
        },
        {
          "command": "printf %s 'a b'"
        },
        {
          "command": "printf %s 'a b'"
        },
        {
          "command": "printf %s 'a b'\necho done"
        }
      ],
      "expect": {
        "stdout": ""
      }
    },
