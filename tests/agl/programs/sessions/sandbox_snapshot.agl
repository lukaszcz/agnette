# Session::default() snapshots sandbox alongside agent at
# first use: a later write to sandbox never reaches an already
# snapshotted default session's reported mode.
import std/config

def classify(mode: AgentSandbox) -> text =
  case mode of
    | Disabled => "disabled"
    | Native => "native"
    | Sandbox(memory, swap, settings, patch) =>
        "sandbox(%{memory}, %{swap}, %{settings}, %{patch})"

program def main() -> unit =
  std/config::agent := AgentPi("writer", "model", "high")
  std/config::sandbox := AgentSandbox::Native
  let first = Session::default()
  print classify(first.sandbox)
  std/config::sandbox := AgentSandbox::Disabled
  let second = Session::default()
  print classify(second.sandbox)
