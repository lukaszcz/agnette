{
  "scenarios": [
    {
      "name": "empty_text_is_valid",
      "agents": {
        "ask": [
          ""
        ],
        "prompter": [
          "7"
        ]
      },
      "expect": {
        "warnings": [{"name": "noop-parse-retries", "line": 6}],
        "stdout": "\nafter\n7\n",
        "calls": {
          "ask": 1,
          "prompter": 1
        }
      }
    },
    {
      "name": "empty_typed_response_fails_parse",
      "runtime": {"parse_error_retries": 0},
      "agents": {
        "ask": [
          "quiet"
        ],
        "prompter": [
          ""
        ]
      },
      "expect": {
        "warnings": [{"name": "noop-parse-retries", "line": 6}],
        "stdout": "quiet\nafter\n",
        "calls": {
          "ask": 1,
          "prompter": 1
        },
        "raises": {
          "type": "AgentParseError",
          "fields": {
            "agent": {
              "$case": "AgentCommand",
              "command": "prompter"
            },
            "attempts": 1
          }
        }
      }
    }
  ]
}
