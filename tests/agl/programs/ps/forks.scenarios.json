{
  "scenarios": [
    {
      "name": "each_process_consumes_its_own_scripts",
      "isolated": true,
      "agents": {"writer": ["parent answer"]},
      "forks": {
        "1": {
          "agents": {
            "writer": {
              "responses": ["child answer"],
              "session": {}
            }
          },
          "shell": [{"command": "echo child-shell", "stdout": "child-shell\n"}],
          "http": [{"status": 201, "body": "", "expect": {"url": "https://x/child"}}],
          "expect": {
            "calls": {"writer": 0},
            "sessions": [{"agent": "writer", "tag": "session-1", "opened": true, "closed": true, "parent": null}],
            "session_prompts": [{"agent": "writer", "session": "session-1", "call": 0, "equals": "child question"}]
          }
        },
        "1.1": {
          "agents": {"writer": ["grandchild answer"]},
          "expect": {"calls": {"writer": 1}}
        },
        "2": {
          "agents": {"writer": ["sibling answer"]},
          "expect": {"calls": {"writer": 1}}
        }
      },
      "expect": {
        "calls": {"writer": 1},
        "stdout": "201\nparent answer\nchild answer/child-shell/grandchild answer\nsibling answer\n"
      }
    }
  ]
}
