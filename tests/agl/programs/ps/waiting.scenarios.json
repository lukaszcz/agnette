{
  "scenarios": [
    {
      "name": "settle_and_settle_any_consume_nothing",
      "isolated": true,
      "params": {"mode": "settle", "root": "$TEMP_ROOT"},
      "filesystem": {},
      "expect": {
        "stdout": "first: 1\nlowest: 1\nnow: 0\nsettled: [10, 20, 30]\nboom bad\nempty array\n"
      }
    },
    {
      "name": "wait_all_policies",
      "isolated": true,
      "params": {"mode": "policies", "root": "$TEMP_ROOT"},
      "filesystem": {},
      "expect": {
        "stdout": "values [1, 2]\nboom slow\nboom first\nslow: 5\nboom only\nstuck: Option::Some(value = 15)\n"
      }
    },
    {
      "name": "wait_all_terminates_many_remaining_processes",
      "isolated": true,
      "params": {"mode": "many", "root": "$TEMP_ROOT"},
      "filesystem": {},
      "expect": {
        "stdout": "boom last\nstuck: Option::Some(value = 15)\nstuck: Option::Some(value = 15)\nstuck: Option::Some(value = 15)\n"
      }
    },
    {
      "name": "wait_all_raise_first_reports_the_childs_raise_site",
      "isolated": true,
      "params": {"mode": "raise-first", "root": "$TEMP_ROOT"},
      "filesystem": {},
      "expect": {
        "raises": {"type": "Boom", "fields": {"tag": "child"}, "message_contains": ["failed child"], "line": 23}
      }
    },
    {
      "name": "wait_all_terminate_rest_reports_the_childs_raise_site",
      "isolated": true,
      "params": {"mode": "terminate-rest", "root": "$TEMP_ROOT"},
      "filesystem": {},
      "expect": {
        "raises": {"type": "Boom", "fields": {"tag": "child"}, "message_contains": ["failed child"], "line": 23}
      }
    }
  ]
}
