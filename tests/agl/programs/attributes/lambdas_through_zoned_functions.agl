# Lambdas flow through higher-order declared functions whose own parameters
# are zoned by attributes. A lambda is called positionally as a function value.

# A higher-order function whose function parameter is positional-only and
# whose seed is named-only.
def apply-twice(@arg-pos function: (int) -> int, @arg-named seed: int) -> int =
  function(function(seed))

# Declaration-level positional-only default over both function parameters.
@arg-pos
def compose(outer: (int) -> int, inner: (int) -> int) -> (int) -> int =
  fn(value: int) -> int => outer(inner(value))

@arg-named
def summarize(values: array[int], keep: (int) -> bool) -> int =
  values.select(keep).fold(0, fn(total: int, value: int) -> int => total + value)

program def main(seed: int, step: int) -> unit =
  let bump = fn(value: int) -> int => value + step
  print bump(seed)

  let scale = fn(value: int) -> int => value * step
  print scale(seed)

  print apply-twice(bump, seed = seed)
  print apply-twice(scale, seed = seed)

  let bumped-scale = compose(bump, scale)
  print bumped-scale(seed)

  # A lambda passed straight into a named-only parameter list, and a lambda
  # chosen by a branch, bound first and passed by shorthand.
  print summarize(values = [seed, step, seed + step], keep = fn(value: int) -> bool => value > 0)
  let differs = fn(value: int) -> bool => value != step
  let exceeds = fn(value: int) -> bool => value > seed
  let keep = if step > seed => differs else => exceeds
  print summarize(keep, values = [seed, step, seed + step])
