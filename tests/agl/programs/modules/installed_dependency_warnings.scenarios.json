{
  "scenarios": [
    {
      "name": "installed_package_warnings_are_capped_even_when_denied",
      "installed_packages": ["packages/tabbed"],
      "warning_levels": {"tab-indentation": "deny"},
      "expect": {"stdout": "42\n"}
    },
    {
      "name": "development_package_warnings_are_reported",
      "packages": ["packages/tabbed"],
      "expect": {
        "warnings": [
          {"name": "tab-indentation", "line": 2, "source": "packages/tabbed/src/lib.agl"}
        ],
        "stdout": "42\n"
      }
    }
  ]
}
