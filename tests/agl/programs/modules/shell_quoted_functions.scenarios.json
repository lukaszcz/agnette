{
  "scenarios": [
    {
      "name": "declared_quoting_functions_are_shell_words",
      "module_roots": [
        "program_modules/modules/shell_quoted"
      ],
      "params": {
        "value": "v"
      },
      "shell": [
        {
          "command": "echo 'v' 'pv' 'v'"
        },
        {
          "command": "echo \"'v'\" ''pv''"
        },
        {
          "command": "echo v ''v''"
        }
      ],
      "expect": {
        "warnings": [
          {
            "name": "shell-quoted-hole",
            "line": 11,
            "column": 16
          },
          {
            "name": "shell-quoted-hole",
            "line": 11,
            "column": 33
          },
          {
            "name": "unquoted-exec-hole",
            "line": 12,
            "column": 15
          }
        ]
      }
    }
  ]
}
