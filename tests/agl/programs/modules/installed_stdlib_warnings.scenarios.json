{
  "scenarios": [
    {
      "name": "installed_stdlib_warnings_are_capped_even_when_denied",
      "stdlib_root": "program_modules/warnings/stdlib",
      "stdlib_installed": true,
      "warning_levels": {"tab-indentation": "deny"},
      "expect": {"stdout": "42\n"}
    },
    {
      "name": "local_stdlib_warnings_are_reported",
      "stdlib_root": "program_modules/warnings/stdlib",
      "expect": {
        "warnings": [
          {
            "name": "tab-indentation",
            "line": 4,
            "source": "program_modules/warnings/stdlib/src/prelude.agl"
          }
        ],
        "stdout": "42\n"
      }
    }
  ]
}
